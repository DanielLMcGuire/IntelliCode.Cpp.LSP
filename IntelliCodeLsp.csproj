<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IntelliCodeLsp</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Point these at your actual IntelliCode extension folder -->
    <Reference Include="ModelInferenceLib">
      <HintPath>E:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\Extensions\Microsoft\IntelliCode\ModelInferenceLib.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.ML.OnnxRuntime">
      <HintPath>E:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\Extensions\Microsoft\IntelliCode\Microsoft.ML.OnnxRuntime.dll</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
